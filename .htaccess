# Apache конфигурация для PRIPLAD.ONLINE

RewriteEngine On

# /api/index.php обслуживается напрямую. Остальные API-маршруты направляем в него.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

# SPA fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [L]

# Запрещаем доступ к конфигу и служебным файлам.
<Files "config.php">
    Require all denied
</Files>

<FilesMatch "\.(env|log|sql|md)$">
    Require all denied
</FilesMatch>

# CORS для API задаётся динамически в PHP по ALLOWED_ORIGINS.
